{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/auth/callback",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/dashboard/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/perfil/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/planes/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/checkout/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/resultados/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/simulacro/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/banco-preguntas/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/clases/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/libro-reclamaciones/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/mtc-official/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/simulador-mtc",
      "destination": "/seo/simulador-mtc.html"
    },
    {
      "source": "/examen-mtc-preguntas",
      "destination": "/seo/examen-mtc-preguntas.html"
    },
    {
      "source": "/senales-de-transito",
      "destination": "/seo/senales-de-transito.html"
    },
    {
      "source": "/reglas-de-transito-peru",
      "destination": "/seo/reglas-de-transito-peru.html"
    },
    {
      "source": "/fuentes-mtc",
      "destination": "/seo/fuentes-mtc.html"
    },
    {
      "source": "/como-aprobar-examen-mtc",
      "destination": "/seo/como-aprobar-examen-mtc.html"
    },
    {
      "source": "/cuantas-preguntas-tiene-examen-mtc",
      "destination": "/seo/cuantas-preguntas-tiene-examen-mtc.html"
    },
    {
      "source": "/balotario-mtc-pdf",
      "destination": "/seo/balotario-mtc-pdf.html"
    },
    {
      "source": "/balotario-mtc-a1-pdf",
      "destination": "/seo/balotario-mtc-a1-pdf.html"
    },
    {
      "source": "/examen-conocimientos-mtc-a1",
      "destination": "/seo/examen-conocimientos-mtc-a1.html"
    },
    {
      "source": "/preguntas-frecuentes-examen-mtc",
      "destination": "/seo/preguntas-frecuentes-examen-mtc.html"
    },
    {
      "source": "/senales-reglamentarias-mtc",
      "destination": "/seo/senales-reglamentarias-mtc.html"
    },
    {
      "source": "/senales-preventivas-mtc",
      "destination": "/seo/senales-preventivas-mtc.html"
    },
    {
      "source": "/preguntas-mtc-semaforo",
      "destination": "/seo/preguntas-mtc-semaforo.html"
    },
    {
      "source": "/prioridad-de-paso-examen-mtc",
      "destination": "/seo/prioridad-de-paso-examen-mtc.html"
    },
    {
      "source": "/adelantamiento-linea-continua-mtc",
      "destination": "/seo/adelantamiento-linea-continua-mtc.html"
    },
    {
      "source": "/manejo-defensivo-examen-mtc",
      "destination": "/seo/manejo-defensivo-examen-mtc.html"
    },
    {
      "source": "/mecanica-basica-examen-mtc",
      "destination": "/seo/mecanica-basica-examen-mtc.html"
    },
    {
      "source": "/primeros-auxilios-examen-mtc",
      "destination": "/seo/primeros-auxilios-examen-mtc.html"
    },
    {
      "source": "/licencia-a1-peru-examen",
      "destination": "/seo/licencia-a1-peru-examen.html"
    },
    {
      "source": "/revalidacion-licencia-mtc-examen",
      "destination": "/seo/revalidacion-licencia-mtc-examen.html"
    },
    {
      "source": "/simulacro-mtc-con-respuestas",
      "destination": "/seo/simulacro-mtc-con-respuestas.html"
    },
    {
      "source": "/temas-mas-dificiles-examen-mtc",
      "destination": "/seo/temas-mas-dificiles-examen-mtc.html"
    },
    {
      "source": "/simulador-mtc-:slug",
      "destination": "/seo/simulador-mtc-:slug.html"
    },
    {
      "source": "/balotario-mtc-:slug",
      "destination": "/seo/balotario-mtc-:slug.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

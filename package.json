{
  "name": "simulador-mtc-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node tools/generate-seo-assets.mjs && vite build",
    "check:question-fidelity": "node tools/check-question-fidelity.mjs",
    "check:practice-selection": "node tools/check-practice-selection.mjs",
    "check:membership-access": "node tools/check-membership-access.mjs",
    "check:category-preference": "node tools/check-category-preference.mjs",
    "check:exam-submission": "node tools/check-exam-submission.mjs",
    "check:simulator-ux": "node tools/check-simulator-ux.mjs",
    "check:email-recipient": "node tools/check-email-recipient.mjs",
    "check:admin-access": "node tools/check-admin-access.mjs",
    "check:admin-complaints": "node tools/check-admin-complaints.mjs",
    "check:admin-operations": "node tools/check-admin-operations.mjs",
    "check:traffic-sources": "node tools/check-traffic-sources.mjs",
    "check:remote-environments": "node tools/check-remote-environments.mjs",
    "check:payment-security": "node tools/check-payment-security.mjs",
    "check:commerce-compliance": "node tools/check-commerce-compliance.mjs",
    "check:sunat-documents": "node tools/check-sunat-documents.mjs",

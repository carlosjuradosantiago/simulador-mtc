  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "@tailwindcss/vite": "latest",
    "clsx": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "7.18.2",
    "recharts": "latest",
    "tailwind-merge": "latest",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "8.2.1"
